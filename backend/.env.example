# Backend Environment Variables
# These variables must be configured in your Render Web Service.

# Port for the Node.js server (Render sets this automatically, but you can define it)
PORT=5000

# MongoDB Connection String (Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.exmaple.mongodb.net/barbershop?retryWrites=true&w=majority

# JWT Authentication Secret Key (Make it a long random string)
JWT_SECRET=sua_super_chave_secreta_jwt_longa_aqui

# Frontend URL (To allow CORS requests from your deployed PWA)
# Example: https://elbraddock.onrender.com (No trailing slash)
FRONTEND_URL=http://localhost:5173

# Email Configurations (For Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-ou-smtp
